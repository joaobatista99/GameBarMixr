<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>GameBarMixr</RootNamespace>
    <AssemblyName>GameBarMixr</AssemblyName>
    <Nullable>enable</Nullable>
    <!-- WinForms: sem XAML, sem XamlCompiler.exe, compila com só o dotnet SDK -->
    <UseWindowsForms>true</UseWindowsForms>
    <WindowsPackageType>None</WindowsPackageType>
    <Platforms>x64;x86</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Xbox Game Bar SDK -->
    <PackageReference Include="Microsoft.Gaming.XboxGameBar" Version="5.1.200401003" />
    <!-- CoreAudio: controle de volume e dispositivos de saída -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
