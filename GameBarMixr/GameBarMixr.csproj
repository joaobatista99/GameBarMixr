<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>GameBarMixr</RootNamespace>
    <AssemblyName>GameBarMixr</AssemblyName>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Framework-dependent: avoids win10-* RID resolution errors no .NET 10 SDK -->
    <SelfContained>false</SelfContained>
    <Platforms>x64;x86;ARM64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Xbox Game Bar SDK (versão disponível no NuGet) -->
    <PackageReference Include="Microsoft.Gaming.XboxGameBar" Version="5.1.200401003" />
    <!-- WinUI 3 / Windows App SDK 1.6.x (compatível com .NET 10 SDK) -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" PrivateAssets="All" />
    <!-- CoreAudio para controle de volume por app (pacote correto: NAudio, não NAudio.CoreAudioApi) -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- Copiar Assets para o diretório de saída -->
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
