<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>GameBarMixr</RootNamespace>
    <AssemblyName>GameBarMixr</AssemblyName>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <WindowsAppSdkSelfContained>true</WindowsAppSdkSelfContained>
    <Platforms>x86;x64;ARM64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Xbox Game Bar SDK -->
    <PackageReference Include="Microsoft.Gaming.XboxGameBar" Version="1.6.1" />
    <!-- WinUI 3 / Windows App SDK -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240311000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" PrivateAssets="All" />
    <!-- CoreAudio para controle de volume por app -->
    <PackageReference Include="NAudio.CoreAudioApi" Version="2.2.1" />
  </ItemGroup>

  <!-- Copiar Assets para o diretório de saída -->
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
