<Application
    x:Class="GameBarMixr.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="XboxAcrylicBackground" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="XboxAccentGreen" Color="#107C41"/>
            <SolidColorBrush x:Key="XboxCardBackground" Color="#2A2A2A"/>
            <SolidColorBrush x:Key="XboxTextPrimary" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="XboxTextSecondary" Color="#B0B0B0"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
