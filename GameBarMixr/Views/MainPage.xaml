<Page
    x:Class="GameBarMixr.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GameBarMixr.Models"
    Background="#181818">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar Header -->
            <RowDefinition Height="Auto"/> <!-- Navigation Pivot / Tabs -->
            <RowDefinition Height="*"/>    <!-- Content Area -->
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7F6;" Foreground="#107C41" FontSize="20" Margin="0,0,8,0"/>
                <TextBlock Text="GameBarMixr" FontSize="18" FontWeight="Bold" Foreground="White"/>
            </StackPanel>

            <Button Grid.Column="1" Click="OnRefreshClicked" ToolTipService.ToolTip="Atualizar Áudio e Bluetooth" Background="#282828" Foreground="White" CornerRadius="4">
                <FontIcon Glyph="&#xE72C;" FontSize="14"/>
            </Button>
        </Grid>

        <!-- Pivot Tabs -->
        <Pivot x:Name="MainPivot" Grid.Row="2" Background="Transparent" Foreground="White">

            <!-- TAB 1: MIXER DE ÁUDIO -->
            <PivotItem Header="Mixer de Áudio">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="0,10,0,0">

                        <!-- Seção 1: Saída de Áudio Ativa -->
                        <TextBlock Text="Dispositivo Padrão de Saída" FontSize="13" FontWeight="SemiBold" Foreground="#B0B0B0"/>

                        <ListView x:Name="AudioDevicesListView" ItemsSource="{x:Bind AudioService.Devices}" SelectionMode="Single" SelectionChanged="OnAudioDeviceSelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:AudioDeviceModel">
                                    <Grid Background="#242424" CornerRadius="6" Padding="10,8" Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="18" Foreground="#107C41" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" Foreground="White" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind VolumePercent, Mode=OneWay, StringFormat='Volume: {0}%'}" FontSize="11" Foreground="#909090"/>
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="#107C41" CornerRadius="10" Padding="6,2" Visibility="{x:Bind IsDefault, Mode=OneWay}">
                                            <TextBlock Text="ATIVO" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Seção 2: Volume dos Jogos & Apps -->
                        <TextBlock Text="Volume por Aplicativo / Jogo" FontSize="13" FontWeight="SemiBold" Foreground="#B0B0B0" Margin="0,10,0,0"/>

                        <ListView x:Name="AppSessionsListView" ItemsSource="{x:Bind AudioService.AppSessions}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:AppAudioSessionModel">
                                    <Grid Background="#242424" CornerRadius="6" Padding="10,8" Margin="0,3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind AppName}" Foreground="White" FontWeight="Medium"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind VolumePercent, Mode=OneWay, StringFormat='{0}%'}" Foreground="#107C41" FontWeight="Bold" FontSize="12"/>
                                        </Grid>

                                        <Slider Grid.Row="1" Value="{x:Bind Volume, Mode=TwoWay}" Minimum="0.0" Maximum="1.0" StepFrequency="0.05" Foreground="#107C41"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <!-- TAB 2: GERENCIADOR BLUETOOTH -->
            <PivotItem Header="Fones Bluetooth">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Margin="0,10,0,0">
                        <TextBlock Text="Dispositivos Bluetooth Emparelhados" FontSize="13" FontWeight="SemiBold" Foreground="#B0B0B0"/>

                        <ListView x:Name="BluetoothListView" ItemsSource="{x:Bind BluetoothService.PairedDevices}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:BluetoothDeviceModel">
                                    <Grid Background="#242424" CornerRadius="8" Padding="12" Margin="0,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header Item -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="20" Foreground="#107C41" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="11" Foreground="#B0B0B0"/>
                                                    <TextBlock Text="{x:Bind BatteryLevel, Mode=OneWay, StringFormat='🔋 {0}%'}" FontSize="11" Foreground="#107C41" Visibility="{x:Bind HasBatteryInfo}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Botão Conectar / Desconectar -->
                                            <Button Grid.Column="2" Content="{x:Bind ActionButtonText, Mode=OneWay}" Click="OnBluetoothActionClicked" Tag="{x:Bind}" Background="#107C41" Foreground="White" CornerRadius="4" Padding="10,4" FontSize="12" FontWeight="SemiBold"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

        </Pivot>
    </Grid>
</Page>
