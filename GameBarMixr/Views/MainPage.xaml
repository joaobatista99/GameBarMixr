<Page
    x:Class="GameBarMixr.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GameBarMixr.Models"
    Background="#121212">

    <Grid Padding="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Minimal Header -->
            <RowDefinition Height="*"/>    <!-- Content Area -->
        </Grid.RowDefinitions>

        <!-- Minimal Header & Tab Selector -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Segmented Pill Selector (Mixer vs Bluetooth) -->
            <StackPanel Orientation="Horizontal" Background="#1E1E1E" CornerRadius="16" Padding="2">
                <Button x:Name="TabAudioBtn" Content="Áudio" Click="OnTabAudioClicked" Style="{StaticResource DefaultButtonStyle}" Background="#107C41" Foreground="White" CornerRadius="14" Padding="12,4" FontSize="12" FontWeight="SemiBold"/>
                <Button x:Name="TabBtBtn" Content="Bluetooth" Click="OnTabBtClicked" Style="{StaticResource DefaultButtonStyle}" Background="Transparent" Foreground="#909090" CornerRadius="14" Padding="12,4" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>

            <Button Grid.Column="1" Click="OnRefreshClicked" ToolTipService.ToolTip="Atualizar" Background="Transparent" Foreground="#808080" CornerRadius="12" Width="30" Height="30" Padding="0">
                <FontIcon Glyph="&#xE72C;" FontSize="12"/>
            </Button>
        </Grid>

        <!-- SECTION 1: MIXER DE ÁUDIO -->
        <ScrollViewer x:Name="AudioSection" Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <StackPanel Spacing="12">
                
                <!-- Quick Output Devices Horizontal List -->
                <TextBlock Text="SAÍDA" FontSize="10" FontWeight="Bold" Foreground="#606060" CharacterSpacing="100"/>
                
                <ListView x:Name="AudioDevicesListView" ItemsSource="{x:Bind AudioService.Devices}" SelectionMode="Single" SelectionChanged="OnAudioDeviceSelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:AudioDeviceModel">
                            <Grid Background="#1A1A1A" CornerRadius="8" Padding="10,8" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="15" Foreground="#107C41" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" Foreground="White" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                <Border Grid.Column="2" Width="8" Height="8" CornerRadius="4" Background="#107C41" VerticalAlignment="Center" Visibility="{x:Bind IsDefault, Mode=OneWay}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Minimal App Volume Sliders -->
                <TextBlock Text="APLICATIVOS" FontSize="10" FontWeight="Bold" Foreground="#606060" CharacterSpacing="100" Margin="0,6,0,0"/>

                <ListView x:Name="AppSessionsListView" ItemsSource="{x:Bind AudioService.AppSessions}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:AppAudioSessionModel">
                            <Grid Background="#161616" CornerRadius="8" Padding="10,8" Margin="0,2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind AppName}" Foreground="#E0E0E0" FontSize="12" FontWeight="Medium"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind VolumePercent, Mode=OneWay, StringFormat='{0}%'}" Foreground="#909090" FontSize="11"/>
                                </Grid>

                                <Slider Grid.Row="1" Value="{x:Bind Volume, Mode=TwoWay}" Minimum="0.0" Maximum="1.0" StepFrequency="0.05" Foreground="#107C41" Margin="0,-4,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </StackPanel>
        </ScrollViewer>

        <!-- SECTION 2: BLUETOOTH MANAGER -->
        <ScrollViewer x:Name="BluetoothSection" Grid.Row="1" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
            <StackPanel Spacing="10">
                <TextBlock Text="FONES BLUETOOTH" FontSize="10" FontWeight="Bold" Foreground="#606060" CharacterSpacing="100"/>

                <ListView x:Name="BluetoothListView" ItemsSource="{x:Bind BluetoothService.PairedDevices}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:BluetoothDeviceModel">
                            <Grid Background="#1A1A1A" CornerRadius="8" Padding="10,8" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Status indicator dot -->
                                <Border Width="6" Height="6" CornerRadius="3" Background="#107C41" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="{x:Bind IsConnected, Mode=OneWay}"/>
                                <Border Width="6" Height="6" CornerRadius="3" Background="#404040" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="{x:Bind IsConnected, Mode=OneWay, Converter={StaticResource BoolToNegatedVisibilityConverter}}"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" Foreground="White" FontSize="12" FontWeight="Medium"/>
                                    <TextBlock Text="{x:Bind BatteryLevel, Mode=OneWay, StringFormat='🔋 {0}%'}" FontSize="10" Foreground="#808080" Visibility="{x:Bind HasBatteryInfo}"/>
                                </StackPanel>

                                <Button Grid.Column="2" Content="{x:Bind ActionButtonText, Mode=OneWay}" Click="OnBluetoothActionClicked" Tag="{x:Bind}" Background="#222222" Foreground="White" CornerRadius="12" Padding="10,3" FontSize="11"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
