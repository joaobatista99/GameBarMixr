<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/new"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 mp rescap"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10">

  <Identity
    Name="GameBarMixr.AudioBluetoothWidget"
    Publisher="CN=GameBarMixrPublisher"
    Version="1.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="8d107a61-9c60-449e-b98a-5e003bf47e09" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>GameBarMixr - Audio &amp; Bluetooth Widget</DisplayName>
    <PublisherDisplayName>GameBarMixr</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Fast audio mixer and Bluetooth headset switcher for Xbox Game Bar on Windows.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Capabilities>
    <Capability Name="internetClient" />
    <DeviceCapability Name="bluetooth" />
  </Capabilities>

  <Applications>
    <Application Id="App"
      Executable="GameBarMixr.exe"
      EntryPoint="GameBarMixr.App">
      <uap:VisualElements
        DisplayName="GameBarMixr"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="GameBarMixr Audio &amp; Bluetooth Mixer Widget"
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
      </uap:VisualElements>

      <Extensions>
        <!-- Xbox Game Bar Widget Registration (correct schema) -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension
            Name="microsoft.gameBarUIExtension"
            Id="GameBarMixr"
            DisplayName="Audio &amp; Bluetooth Mixer"
            Description="Fast audio and Bluetooth mixer for Xbox Game Bar"
            PublicFolder="Public">
            <uap3:Properties>
              <GameBarWidget
                Type="Standard"
                PinningSupported="true"
                Height="440"
                Width="330"
                AlwaysPin="false" />
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
