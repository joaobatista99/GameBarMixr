<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/new"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 mp rescap">

  <Identity
    Name="GameBarMixr.AudioBluetoothWidget"
    Publisher="CN=GameBarMixrPublisher"
    Version="1.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="8d107a61-9c60-449e-b98a-5e003bf47e09" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>GameBarMixr - Audio &amp; Bluetooth Widget</DisplayName>    <PublisherDisplayName>GameBarMixr</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Mixer de áudio rápido e gerenciador de fones Bluetooth para a Xbox Game Bar do Windows. Troque de dispositivo e ajuste volumes sem perder o foco dos jogos!</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Capabilities>
    <Capability Name="internetClient" />
    <DeviceCapability Name="bluetooth" />
  </Capabilities>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="GameBarMixr.App">
      <uap:VisualElements
        DisplayName="GameBarMixr"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="GameBarMixr Audio &amp; Bluetooth Mixer Widget"
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- Registro oficial do Xbox Game Bar Widget -->
        <uap3:Extension Category="windows.xboxGameBarWidget">
          <uap3:XboxGameBarWidget
            Id="GameBarMixr"
            Title="Audio &amp; Bluetooth Mixer"
            AppId="App"
            SettingsSupported="false"
            PinningSupported="true"
            Height="520"
            Width="380" />
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
